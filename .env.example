# ═════════════════════════════════════════════════════════════════════════════
# LMView — Environment Configuration
# ═════════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# This file is the SINGLE SOURCE OF TRUTH for all environment-specific
# configuration. Every docker-compose.yml and script reads from here.
#
# Node topology (Docker Swarm):
#   core   = manager node(s): databases, brokers, API, frontend, AI
#   worker = worker node(s): Flink, Spark, Trino, Dagster, monitoring
#
# For a single-host setup (dev), all services run on one machine.
# For multi-node Swarm, set role labels:
#   docker node update --label-add role=core  <manager-node>
#   docker node update --label-add role=worker <worker-node>
# ═════════════════════════════════════════════════════════════════════════════

# ── App Mode (informational) ──────────────────────────────────────────────────
APP_ENV=${APP_ENV:-development}

# ── InfluxDB ──────────────────────────────────────────────────────────────────
INFLUX_TOKEN=${INFLUX_TOKEN:-change-me-to-a-strong-random-token}
INFLUX_ADMIN_USER=${INFLUX_ADMIN_USER:-admin}
INFLUX_ADMIN_PASSWORD=${INFLUX_ADMIN_PASSWORD:-change-me}
INFLUX_ORG=${INFLUX_ORG:-vi}
INFLUX_BUCKET=${INFLUX_BUCKET:-crypto}

# ── MinIO (S3-compatible storage for Iceberg) ────────────────────────────────
MINIO_ROOT_USER=${MINIO_ROOT_USER:-minioadmin}
MINIO_ROOT_PASSWORD=${MINIO_ROOT_PASSWORD:-minioadmin}

# ── PostgreSQL (auth, settings, AI persistence, Iceberg catalog) ─────────────
POSTGRES_USER=${POSTGRES_USER:-iceberg}
POSTGRES_PASSWORD=${POSTGRES_PASSWORD:-change-me}
POSTGRES_DB=${POSTGRES_DB:-iceberg_catalog}
POSTGRES_HOST=${POSTGRES_HOST:-postgres}
POSTGRES_LMVIEW_DB=${POSTGRES_LMVIEW_DB:-iceberg_catalog}
RUN_MIGRATIONS=${RUN_MIGRATIONS:-false}
SESSION_EXPIRY_HOURS=${SESSION_EXPIRY_HOURS:-168}

# Default admin (bootstrapped when no admin exists)
DEFAULT_ADMIN_EMAIL=${DEFAULT_ADMIN_EMAIL:-admin@example.com}
DEFAULT_ADMIN_INITIAL_PASSWORD=${DEFAULT_ADMIN_INITIAL_PASSWORD:-change-me-admin-password}
DEFAULT_ADMIN_DISPLAY_NAME=${DEFAULT_ADMIN_DISPLAY_NAME:-LMView Admin}
DEFAULT_ADMIN_USERNAME=${DEFAULT_ADMIN_USERNAME:-admin}

# ── Redis (hot cache for ticker, candles, orderbook, trades) ──────────────────
REDIS_HOST=${REDIS_HOST:-redis-master}
REDIS_PORT=${REDIS_PORT:-6379}
REDIS_SENTINELS=${REDIS_SENTINELS:-redis-sentinel-1:26379,redis-sentinel-2:26379,redis-sentinel-3:26379}
REDIS_MASTER_NAME=${REDIS_MASTER_NAME:-mymaster}

# ── Kafka (message bus for data pipeline) ─────────────────────────────────────
KAFKA_BOOTSTRAP=${KAFKA_BOOTSTRAP:-kafka-1:9092,kafka-2:9092,kafka-3:9092}
SCHEMA_REGISTRY_URL=${SCHEMA_REGISTRY_URL:-http://schema-registry:8080/apis/ccompat/v7}

# ── Trino (SQL engine for Iceberg lakehouse) ──────────────────────────────────
TRINO_HOST=${TRINO_HOST:-trino}
TRINO_PORT=${TRINO_PORT:-8080}

# ── InfluxDB retention ────────────────────────────────────────────────────────
INFLUX_1M_RETENTION_DAYS=${INFLUX_1M_RETENTION_DAYS:-90}

# ── Vite / Frontend ───────────────────────────────────────────────────────────
# Leave blank/"api" for API mode, "mock" for mock data
VITE_DATA_SOURCE=${VITE_DATA_SOURCE:-}
VITE_API_BASE_URL=${VITE_API_BASE_URL:-}

# ── Dagster (data orchestration) ──────────────────────────────────────────────
DAGSTER_PG_URL=${DAGSTER_PG_URL:-postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/dagster}

# ── HTTPS (Let's Encrypt via certbot) ─────────────────────────────────────────
CERTBOT_DOMAIN=${CERTBOT_DOMAIN:-example.com}
CERTBOT_EMAIL=${CERTBOT_EMAIL:-you@example.com}
CERTBOT_RENEW_INTERVAL_SECONDS=${CERTBOT_RENEW_INTERVAL_SECONDS:-43200}
NGINX_AUTO_RELOAD_ENABLE=${NGINX_AUTO_RELOAD_ENABLE:-1}
NGINX_RELOAD_INTERVAL_SECONDS=${NGINX_RELOAD_INTERVAL_SECONDS:-21600}

# DuckDNS (optional — for dynamic DNS)
DUCKDNS_TOKEN=${DUCKDNS_TOKEN:-change-me}
DUCKDNS_SUBDOMAINS=${DUCKDNS_SUBDOMAINS:-your-subdomain}
DUCKDNS_UPDATE_INTERVAL_SECONDS=${DUCKDNS_UPDATE_INTERVAL_SECONDS:-300}

# ── Monitoring ────────────────────────────────────────────────────────────────
MONITORING_USER=${MONITORING_USER:-admin}
MONITORING_PASSWORD=${MONITORING_PASSWORD:-change-me}
GRAFANA_ADMIN_PASSWORD=${GRAFANA_ADMIN_PASSWORD:-admin}

# ── AI / LLM Provider ─────────────────────────────────────────────────────────
# AI_MODE: auto | local | api | none
AI_MODE=${AI_MODE:-api}
AI_CONFIG_PATH=${AI_CONFIG_PATH:-ai_service/configs/ai.local.yaml}

# AI orchestration (langgraph is the only mode in v0.26+)
AI_ORCHESTRATION=${AI_ORCHESTRATION:-langgraph}

# AI_SERVICE_EMBEDDED: false = proxy to standalone ai-service container
#                       true = import ai_service directly (legacy, heavy)
AI_SERVICE_EMBEDDED=${AI_SERVICE_EMBEDDED:-false}
AI_SERVICE_URL=${AI_SERVICE_URL:-http://ai-service:8100}

# AI_ENABLE_REAL_LLM: enable real LLM inference (vs mock/fallback responses)
AI_ENABLE_REAL_LLM=${AI_ENABLE_REAL_LLM:-true}

# RAG: knowledge retrieval for AI assistant
AI_ENABLE_RAG=${AI_ENABLE_RAG:-true}

# Provider API keys (set whichever you use)
# DASHSCOPE_API_KEY=
# QWEN_API_KEY=
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# ── LiteLLM proxy (optional AI routing layer) ─────────────────────────────────
LITELLM_BASE_URL=${LITELLM_BASE_URL:-http://litellm:4000}
# LITELLM_MASTER_KEY=

# ── Cloud Infrastructure (Docker Swarm) ───────────────────────────────────────
# EFS mount path — must be the same on ALL Swarm nodes.
# Used for volume bind mounts so code/config syncs across nodes.
AWS_EFS_MOUNT_PATH=${AWS_EFS_MOUNT_PATH:-/mnt/efs/LMView}

# Local Docker registry address (for multi-node image distribution).
# On 2-node: registry runs on core node at <CORE_PRIVATE_IP>:5000.
# On 3-node: can run on any manager node.
REGISTRY_ADDR=${REGISTRY_ADDR:-localhost:5000}

# Docker Swarm stack name
STACK_NAME=${STACK_NAME:-cryptoprice}

# Swarm node placement labels (set on each node):
#   docker node update --label-add role=core  <manager-node>
#   docker node update --label-add role=worker <worker-node>
# For 3-node, you may add more labels:
#   docker node update --label-add role=worker2 <third-node>

# ── AWS EC2 Setup (used by scripts/setup_node.sh) ────────────────────────────
AWS_EFS_FS_ID=${AWS_EFS_FS_ID:-fs-xxxxxxxx}
AWS_REGION=${AWS_REGION:-us-east-1}

# ── Migration & Tuning (Optional) ────────────────────────────────────────────
RETENTION_1M_DAYS=${RETENTION_1M_DAYS:-90}
CORS_ORIGINS=${CORS_ORIGINS:-}
RATE_LIMIT_PER_MINUTE=${RATE_LIMIT_PER_MINUTE:-200}

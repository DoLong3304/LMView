# ─── Environment Mode ────────────────────────────────────────────────────────
# Informational app mode. Runtime selection uses the single docker-compose.yml
# with explicit profiles such as `dev`, `prod`, `monitoring`, and `logging`.
APP_ENV=development

# ─── InfluxDB ────────────────────────────────────────────────────────────────
# Generate a strong token — any string works (used as InfluxDB admin API token)
INFLUX_TOKEN=change-me-to-a-strong-random-token
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=change-me
INFLUX_ORG=vi
INFLUX_BUCKET=crypto

# ─── MinIO ───────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# PostgreSQL serves the Iceberg JDBC catalog plus app auth/AI/settings storage.
POSTGRES_USER=iceberg
POSTGRES_PASSWORD=change-me
POSTGRES_DB=iceberg_catalog

# FastAPI app DB defaults to the same database unless you split it deliberately.
POSTGRES_HOST=postgres
POSTGRES_LMVIEW_DB=iceberg_catalog
RUN_MIGRATIONS=false
SESSION_EXPIRY_HOURS=168

# Default admin bootstrap. Used only when no active admin account exists.
# The initial password is never logged and must be changed after first login.
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_INITIAL_PASSWORD=change-me-admin-password
DEFAULT_ADMIN_DISPLAY_NAME=LMView Admin
DEFAULT_ADMIN_USERNAME=admin

# ─── Redis ───────────────────────────────────────────────────────────────────
# Local fallback values. Compose services pass Redis Sentinel/master settings.
REDIS_HOST=localhost
REDIS_PORT=6379

# ──── Dagster ────────────────────────────────────────────────────────────────────
DAGSTER_PG_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/dagster

# ─── Vite ───────────────────────────────────────────────────────────────────
# Leave blank/"api" for API mode, "mock" for mock data mode
VITE_DATA_SOURCE=
VITE_API_BASE_URL=

# ─── HTTPS Automation (Let's Encrypt via certbot) ────────────────────────────
# CERTBOT_DOMAIN can be any domain: DuckDNS subdomain, custom domain, etc.
# In dev mode, HTTPS is disabled entirely (plain HTTP on port 80).
CERTBOT_DOMAIN=example.com
CERTBOT_EMAIL=you@example.com
CERTBOT_RENEW_INTERVAL_SECONDS=43200
NGINX_AUTO_RELOAD_ENABLE=1
NGINX_RELOAD_INTERVAL_SECONDS=21600

# DuckDNS settings (optional — only needed if using a DuckDNS domain)
# Token from duckdns.org, subdomain without .duckdns.org suffix
DUCKDNS_TOKEN=change-me
DUCKDNS_SUBDOMAINS=your-subdomain
DUCKDNS_UPDATE_INTERVAL_SECONDS=300


# ─── Monitoring ──────────────────────────────────────────────────────────────
# Basic Auth for Prometheus/Loki (accessed via nginx at /prometheus/ and /loki/)
MONITORING_USER=admin
MONITORING_PASSWORD=change-me
# Grafana admin password (accessed via nginx at /grafana/)
GRAFANA_ADMIN_PASSWORD=admin

# ─── AI / LLM Provider ──────────────────────────────────────────────────────
# AI_MODE: mock | api | local | auto
#   mock  — deterministic mock responses only (default/fallback)
#   api   — prefer online API providers
#   local — prefer local vLLM (requires GPU)
#   auto  — try local first, then api, then mock
# Real provider/RAG paths need runtime deps (`litellm`, `sentence-transformers`)
# plus provider keys/pgvector. Core FastAPI falls back cleanly when absent.
AI_MODE=mock
AI_ENABLE_REAL_LLM=false
AI_ENABLE_RAG=true

# Provider priority order (comma-separated)
# AI_PROVIDER_ORDER=local_vllm,qwen_api,llama_api,openai,gemini,deepseek,litellm_proxy,mock
# AI_TEST_PROVIDER_ORDER=qwen_api,llama_api,local_vllm,openai,gemini,deepseek,litellm_proxy,mock
# AI_ENABLE_PROVIDER_FALLBACK=true

# LLM API keys (set the ones you want to use)
# QWEN_API_KEY=
# LLAMA_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=

# LiteLLM proxy (for running your own LiteLLM proxy)
# LITELLM_BASE_URL=http://litellm:4000
# LITELLM_MASTER_KEY=

# Local vLLM settings (requires ai-local docker profile + GPU)
# VLLM_BASE_URL=http://vllm:8000/v1
# VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# RAG / Embeddings
# AI_EMBEDDING_MODEL=all-MiniLM-L6-v2
# AI_RAG_TOP_K=6
# AI_RAG_MIN_SCORE=0.25
# AI_KB_APPROVED_ONLY=true
# AI_REQUEST_TIMEOUT_SECONDS=60
# AI_MAX_CONTEXT_TOKENS=12000

# ─── Tuning & Configuration (Optional) ───────────────────────────────────
# These variables can be used to modify system behaviors if passed to containers.
# Ensure that docker-compose.yml passes them using string interpolation (e.g., ${VAR}).

# Producer parameters
# KLINE_INTERVAL=1m
# DEPTH_LEVEL=20
# DEPTH_UPDATE_MS=100
# SYMBOLS_PER_CONNECTION=25
# SYMBOLS_PER_DEPTH_CONN=15
# MAX_SYMBOLS=200

# Direct Redis Bypass (resilience path)
# ENABLE_DIRECT_REDIS=false

# Retention policies
# RETENTION_1M_DAYS=90

# Batch & Backfill processing
# BACKFILL_FLUSH_THRESHOLD=10000
# BACKFILL_SPARK_CORES_MAX=2
# BACKFILL_SPARK_SHUFFLE_PARTITIONS=8

# Backend Serving
# CORS_ORIGINS=*
# KAFKA_BOOTSTRAP=kafka:9092
# SCHEMA_REGISTRY_URL=http://schema-registry:8080/apis/ccompat/v7

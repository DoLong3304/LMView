{
  "annotations": {
    "list": []
  },
  "description": "Cost attribution dashboard: AI cost by provider, token usage, cost projection, cost anomalies. Use to track LLM spending and forecast monthly costs.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "Phase 5: Executive Overview",
      "url": "/d/phase5-executive-overview",
      "type": "link",
      "asDropdown": false,
      "includeVars": false,

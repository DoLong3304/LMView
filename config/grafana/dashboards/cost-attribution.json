      "tags": [
        "phase5"
      ],
      "targetBlank": false
    },
    {
      "title": "AI Ask Mode",
      "url": "/d/phase5-ai-ask-mode",
      "type": "link",
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "tags": [
        "phase5"
      ],
      "targetBlank": false
    },
    {
      "title": "Business Metrics",
      "url": "/d/phase5-business-metrics",
      "type": "link",
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "tags": [
        "phase5"
      ],
      "targetBlank": false
    }
  ],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Cost Summary",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "AI Cost Today (USD)",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(increase(ai_cost_usd_total[24h]))",
          "legendFormat": "today",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "AI Cost 7d (USD)",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(increase(ai_cost_usd_total[7d]))",
          "legendFormat": "7d",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "AI Cost 30d (USD)",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(increase(ai_cost_usd_total[30d]))",
          "legendFormat": "30d",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Avg Cost per Request",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(increase(ai_cost_usd_total[24h])) / sum(increase(ai_requests_total[24h]))",
          "legendFormat": "USD/req",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4
        }
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Cost Breakdown by Provider",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Cost per Day by Provider (USD)",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (provider) (increase(ai_cost_usd_total[24h]))",
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 12,
      "type": "piechart",
      "title": "Cost Share by Provider (7d)",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 12,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (provider) (increase(ai_cost_usd_total[7d]))",
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ],
      "options": {
        "pieType": "donut",
        "legend": {
          "displayMode": "list",
          "placement": "right"
        }
      }
    },
    {
      "id": 13,
      "type": "bargauge",
      "title": "Cost per Request by Provider",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 18,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (provider) (increase(ai_cost_usd_total[24h])) / sum by (provider) (increase(ai_requests_total[24h]))",
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        }
      }
    },
    {
      "id": 20,
      "type": "row",
      "title": "Token Usage",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Tokens per Hour by Provider (input vs output)",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (provider) (rate(ai_tokens_used_total{type=\"input\"}[1h])) * 3600",
          "legendFormat": "in {{provider}}",
          "refId": "A"
        },
        {
          "expr": "sum by (provider) (rate(ai_tokens_used_total{type=\"output\"}[1h])) * 3600",
          "legendFormat": "out {{provider}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 22,
      "type": "stat",
      "title": "Total Tokens Today (M)",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 12,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(increase(ai_tokens_used_total[24h])) / 1e6",
          "legendFormat": "M",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2
        }
      }
    },
    {
      "id": 23,
      "type": "gauge",
      "title": "Output/Input Token Ratio",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 18,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(rate(ai_tokens_used_total{type=\"output\"}[5m])) / sum(rate(ai_tokens_used_total{type=\"input\"}[5m]))",
          "legendFormat": "ratio",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      }
    },
    {
      "id": 30,
      "type": "row",
      "title": "Cost Projection & Anomaly Detection",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Cumulative Cost (30d) + Linear Projection",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(increase(ai_cost_usd_total[30d]))",
          "legendFormat": "actual 30d",
          "refId": "A"
        },
        {
          "expr": "predict_linear(sum(increase(ai_cost_usd_total[30d]))[7d], 30*86400)",
          "legendFormat": "projected 30d",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "Hourly Cost vs 24h Baseline (Anomaly Detection)",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(increase(ai_cost_usd_total[1h]))",
          "legendFormat": "this hour",
          "refId": "A"
        },
        {
          "expr": "avg_over_time(sum(increase(ai_cost_usd_total[1h]))[24h:1h])",
          "legendFormat": "24h avg",
          "refId": "B"
        },
        {
          "expr": "2 * avg_over_time(sum(increase(ai_cost_usd_total[1h]))[24h:1h])",
          "legendFormat": "2x threshold (anomaly)",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 40,
      "type": "row",
      "title": "Cost by AI Function",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 41,
      "type": "timeseries",
      "title": "AI Request Cost by Scope Gate Decision",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (decision) (rate(ai_scope_gate_decisions_total[5m])) * on() group_left() sum(rate(ai_cost_usd_total[5m])) / sum(rate(ai_requests_total[5m]))",
          "legendFormat": "{{decision}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        }
      }
    },
    {
      "id": 42,
      "type": "timeseries",
      "title": "Provider Latency vs Cost Trade-off",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 31
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, provider) (rate(ai_provider_latency_seconds_bucket[5m])))",
          "legendFormat": "p50 {{provider}}",
          "refId": "A"
        },
        {
          "expr": "sum by (provider) (rate(ai_cost_usd_total[5m])) / sum by (provider) (rate(ai_provider_requests_total[5m]))",
          "legendFormat": "USD/req {{provider}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ],
  "refresh": "1m",
  "schemaVersion": 38,

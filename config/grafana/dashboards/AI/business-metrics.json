    {
      "id": 43,
      "type": "timeseries",
      "title": "HTTP Requests by Status Code",
      "gridPos": {
        "h": 6,
        "w": 16,
        "x": 8,
        "y": 38
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(api_requests_total[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"

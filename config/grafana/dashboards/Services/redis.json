{
  "annotations": {"list": []},
  "description": "Redis master + replicas: connected clients, memory, commands, latency",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {"title": "Application Logs", "url": "/d/phase5-logs-redis", "type": "link", "asDropdown": false, "includeVars": false, "keepTime": true, "tags": ["logs"]}
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Connected Clients",
      "id": 1,
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value", "colorMode": "value", "graphMode": "area"},
      "fieldConfig": {"defaults": {"unit": "none"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(redis_connected_clients)", "refId": "A"}
      ]
    },
    {
      "type": "stat",
      "title": "Memory Used",
      "id": 2,
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value", "colorMode": "value", "graphMode": "area"},
      "fieldConfig": {"defaults": {"unit": "bytes"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(redis_memory_used_bytes)", "refId": "A"}
      ]
    },
    {
      "type": "stat",
      "title": "Commands / sec",
      "id": 3,
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value", "colorMode": "value", "graphMode": "area"},
      "fieldConfig": {"defaults": {"unit": "ops"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(rate(redis_commands_total[1m]))", "refId": "A"}
      ]
    },
    {
      "type": "stat",
      "title": "Failed Commands / sec",
      "id": 4,
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value", "colorMode": "value", "graphMode": "area"},
      "fieldConfig": {"defaults": {"unit": "ops", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 10}]}}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(rate(redis_commands_failed_calls_total[1m]))", "refId": "A"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory Used (per instance)",
      "id": 5,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}},
      "fieldConfig": {"defaults": {"unit": "bytes", "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10}}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "redis_memory_used_bytes", "legendFormat": "{{instance}}", "refId": "A"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Connected Clients (per instance)",
      "id": 6,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}},
      "fieldConfig": {"defaults": {"unit": "none", "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10}}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "redis_connected_clients", "legendFormat": "{{instance}}", "refId": "A"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Command Latency p99 (us) - top 5 commands",
      "id": 7,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}},
      "fieldConfig": {"defaults": {"unit": "µs", "custom": {"drawStyle": "line", "lineWidth": 2}}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "topk(5, redis_latency_percentiles_usec{quantile=\"99\"})", "legendFormat": "{{cmd}}", "refId": "A"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Commands / sec (per instance)",
      "id": 8,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}},
      "fieldConfig": {"defaults": {"unit": "ops", "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10}}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (instance) (rate(redis_commands_total[1m]))", "legendFormat": "{{instance}}", "refId": "A"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Replica Lag (seconds)",
      "id": 9,
      "gridPos": {"h": 7, "w": 24, "x": 0, "y": 21},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}},
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10}}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "redis_connected_slave_lag_seconds", "legendFormat": "{{instance}} lag", "refId": "A"}
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["services", "redis"],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Service / Redis",
  "uid": "phase5-services-redis",
  "version": 1,
  "weekStart": ""
}

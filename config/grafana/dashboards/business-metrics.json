      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(active_users_24h) or vector(0)",
          "legendFormat": "users",
          "refId": "A"
        }

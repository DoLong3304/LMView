{
  "annotations": {
    "list": []
  },
  "description": "SLO burn-rate tracking (Google SRE Workbook style). Multi-window multi-burn-rate alerts (1h fast / 6h medium / 24h slow / 72h ultra-slow). Tracks error budget consumption for the 5 defined SLOs.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "Phase 5: Executive Overview",
      "url": "/d/phase5-executive-overview",
      "type": "link",
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "tags": [
        "phase5"
      ],
      "targetBlank": false
    },
    {
      "title": "Business Metrics",
      "url": "/d/phase5-business-metrics",
      "type": "link",
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "tags": [
        "phase5"
      ],
      "targetBlank": false
    },
    {
      "title": "Error Triage",
      "url": "/d/phase5-error-triage",
      "type": "link",
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "tags": [
        "phase5"
      ],
      "targetBlank": false
    }
  ],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "SLO Summary (current status)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "API Availability (target 99.9%)",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "1 - (sum(rate(api_requests_total{status=~\"5..\"}[30d])) / sum(rate(api_requests_total[30d])))",
          "legendFormat": "sli 30d",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0.99,
          "max": 1,
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.999
              },
              {
                "color": "green",
                "value": 0.9995
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "API p99 Latency (target < 500ms)",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(api_request_duration_seconds_bucket[30d])))",
          "legendFormat": "p99 30d",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Days Into Period (28d)",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "(time() - (time() - 28*86400) + (time() % (28*86400))) / 86400",
          "legendFormat": "day",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1
        }
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "API Availability Burn Rate (1 - SLI) / (1 - SLO)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Burn Rate (multi-window) - target 1.0 = on pace to exhaust budget",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "(1 - (sum(rate(api_requests_total{status=~\"5..\"}[1h])) / sum(rate(api_requests_total[1h])))) / 0.001",
          "legendFormat": "1h burn",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "(1 - (sum(rate(api_requests_total{status=~\"5..\"}[6h])) / sum(rate(api_requests_total[6h])))) / 0.001",
          "legendFormat": "6h burn",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "(1 - (sum(rate(api_requests_total{status=~\"5..\"}[24h])) / sum(rate(api_requests_total[24h])))) / 0.001",
          "legendFormat": "24h burn",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "(1 - (sum(rate(api_requests_total{status=~\"5..\"}[72h])) / sum(rate(api_requests_total[72h])))) / 0.001",
          "legendFormat": "72h burn",
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 12,
      "type": "gauge",
      "title": "Error Budget Remaining (30d window)",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 12,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "100 - ((1 - (1 - (sum(rate(api_requests_total{status=~\"5..\"}[30d])) / sum(rate(api_requests_total[30d])))) / 0.001) * 100)",
          "legendFormat": "budget",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 25
              },
              {
                "color": "green",
                "value": 50
              }
            ]
          }
        }
      }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "5xx Rate (5m)",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 18,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(rate(api_requests_total{status=~\"5..\"}[5m]))",
          "legendFormat": "5xx/s",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      }
    },
    {
      "id": 50,
      "type": "row",
      "title": "Multi-Window Multi-Burn-Rate Alerts (SRE Workbook)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 38
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 51,
      "type": "table",
      "title": "Active MWMB Alerts (Page Severity = burn rate 2x in 1h AND 5x in 6h)",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 39
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "((1 - (sum(rate(api_requests_total{status=~\"5..\"}[1h])) / sum(rate(api_requests_total[1h])))) > 2 * 0.001) and ((1 - (sum(rate(api_requests_total{status=~\"5..\"}[6h])) / sum(rate(api_requests_total[6h])))) > 5 * 0.001)",
          "refId": "A",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "showHeader": true
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": [
    "phase5",
    "dataflow",
    "slo",
    "sre",
    "burn-rate"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "Phase 5: SLO Burn-Rate Tracking",
  "uid": "phase5-slo-burn-rate",
  "version": 1,
  "weekStart": ""
}
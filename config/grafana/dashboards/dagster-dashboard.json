{
  "title": "Dagster Dashboard",
  "tags": [
    "dagster",
    "orchestration"
  ],
  "panels": [
    {
      "title": "Total Runs",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "dagster_pipeline_run_total",
          "legendFormat": "runs",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Success Rate",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(dagster_pipeline_run_success_total[5m]))/sum(rate(dagster_pipeline_run_total[5m]))*100",
          "legendFormat": "%",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Active Pipes",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "dagster_pipeline_run_active",
          "legendFormat": "active",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Run Duration p95",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95,rate(dagster_pipeline_run_duration_seconds_bucket[5m]))",
          "legendFormat": "sec",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "value"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      }
    },
    {
      "title": "Success vs Fail (5m)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "rate(dagster_pipeline_run_success_total[5m])",
          "legendFormat": "success",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "title": "Dagster Logs",
      "type": "logs",
      "gridPos": {
        "h": 10,
        "w": 6,
        "x": 6,
        "y": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "targets": [
        {
          "expr": "{service=~\"dagster-webserver|dagster-daemon\"} | json",
          "queryType": "range"
        }
      ],
      "options": {
        "showLabels": true,
        "showTime": true,
        "wrapLogMessage": true
      }
    }
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s"
}
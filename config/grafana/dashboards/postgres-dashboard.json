{
  "title": "Postgres Dashboard",
  "tags": [
    "postgres",
    "database"
  ],
  "panels": [
    {
      "title": "Active Connections",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "pg_stat_database_numbackends{datname=\"postgres\"}",
          "legendFormat": "conns",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Cache Hit Ratio",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "rate(pg_stat_database_blks_hit[5m])/(rate(pg_stat_database_blks_hit[5m])+rate(pg_stat_database_blks_read[5m]))*100",
          "legendFormat": "%",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Transaction Rate",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "rate(pg_stat_database_xact_commit[5m])",
          "legendFormat": "/s",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Transaction Rate (5m)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "rate(pg_stat_database_xact_commit[5m])+rate(pg_stat_database_xact_rollback[5m])",
          "legendFormat": "tps",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "title": "Lock Count",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "pg_locks_count",
          "legendFormat": "locks",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Connections (5m)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "pg_stat_database_numbackends",
          "legendFormat": "active",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "title": "Replication Lag",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 8,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "pg_stat_replication_replay_lag_seconds",
          "legendFormat": "sec",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "value"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      }
    },
    {
      "title": "Postgres Logs",
      "type": "logs",
      "gridPos": {
        "h": 10,
        "w": 6,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "targets": [
        {
          "expr": "{service=~\"postgres\"} | json",
          "queryType": "range"
        }
      ],
      "options": {
        "showLabels": true,
        "showTime": true,
        "wrapLogMessage": true
      }
    }
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s"
}
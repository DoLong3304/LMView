{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "title": "Multi-Source Fallback (Phase 5)",
  "tags": [
    "fallback",
    "redis",
    "influxdb",
    "trino",
    "phase5",
    "dataflow"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "source",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "PBFA97CFB590B2093"
        },
        "query": "label_values(multi_source_lookups_total, source)",
        "refresh": 2,
        "includeAll": true,
        "multi": true
      },
      {
        "name": "data_type",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "PBFA97CFB590B2093"
        },
        "query": "label_values(multi_source_lookups_total, data_type)",
        "refresh": 2,
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Source Hit Rate (5m avg)",
      "description": "Hit rate per data source: Redis (hot), InfluxDB (warm), Trino (cold), REST API (exchange fallback)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.7
              },
              {
                "color": "green",
                "value": 0.9
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(rate(multi_source_lookups_total{source=~\"$source\",result=\"success\"}[5m])) by (source) / clamp_min(sum(rate(multi_source_lookups_total{source=~\"$source\"}[5m])) by (source), 0.001)",
          "legendFormat": "{{source}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Lookups / second (by source and result)",
      "description": "Multi-source lookups per second, broken down by result (success/stale/error)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 8,
        "w": 18,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "stacking": {
              "mode": "normal"
            }
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum",
            "max"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(rate(multi_source_lookups_total{source=~\"$source\"}[1m])) by (source, result)",
          "legendFormat": "{{source}} / {{result}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Source Latency p50 / p95 / p99",
      "description": "Lookup latency percentiles per source",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(source_lookup_duration_seconds_bucket{source=~\"$source\"}[5m])) by (le, source))",
          "legendFormat": "p50 {{source}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(source_lookup_duration_seconds_bucket{source=~\"$source\"}[5m])) by (le, source))",
          "legendFormat": "p95 {{source}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(source_lookup_duration_seconds_bucket{source=~\"$source\"}[5m])) by (le, source))",
          "legendFormat": "p99 {{source}}",
          "refId": "C"
        }
      ]
    },
    {
      "id": 4,
      "title": "Chain Outcome: Which source finally served the request?",
      "description": "Multi-source lookup chain terminations (which source answered last)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "stacking": {
              "mode": "percent"
            }
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(multi_source_chain_outcome_total[1m])) by (terminating_source, data_type)",
          "legendFormat": "{{data_type}} <- {{terminating_source}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Source Unavailability Events",
      "description": "Source unavailable events (network errors, timeouts) per reason",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "stacking": {
              "mode": "normal"
            }
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(source_unavailable_total[1m])) by (source, reason)",
          "legendFormat": "{{source}} / {{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Stale Data Incidents",
      "description": "Stale-data incidents (data older than freshness threshold) per source",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "stacking": {
              "mode": "normal"
            }
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(source_stale_data_total[1m])) by (source, data_type)",
          "legendFormat": "{{source}} / {{data_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Stale Data Ratio (per source)",
      "description": "Ratio of stale-data lookups to all lookups, per source",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(source_stale_data_total{source=~\"$source\"}[5m])) by (source) / clamp_min(sum(rate(multi_source_lookups_total{source=~\"$source\"}[5m])) by (source), 0.001)",
          "legendFormat": "{{source}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Source Health Score",
      "description": "Composite health score per source: success rate * (1 - error rate) * (1 - stale rate)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "(1 - sum(rate(source_unavailable_total{source=~\"$source\"}[5m])) by (source) / clamp_min(sum(rate(multi_source_lookups_total{source=~\"$source\"}[5m])) by (source), 0.001)) * (1 - sum(rate(source_stale_data_total{source=~\"$source\"}[5m])) by (source) / clamp_min(sum(rate(multi_source_lookups_total{source=~\"$source\"}[5m])) by (source), 0.001))",
          "legendFormat": "{{source}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Per-Data-Type Hit Rate",
      "description": "Hit rate breakdown by data type (candle, ticker, indicator, kline_*)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(multi_source_lookups_total{result=\"success\",data_type=~\"$data_type\"}[5m])) by (source, data_type) / clamp_min(sum(rate(multi_source_lookups_total{data_type=~\"$data_type\"}[5m])) by (source, data_type), 0.001)",
          "legendFormat": "{{source}} / {{data_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Stale Symbols (top 10)",
      "description": "Top 10 symbols with the oldest last-update timestamp per source",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "expr": "topk(10, time() - source_last_update_timestamp_seconds)",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ]
    }
  ],

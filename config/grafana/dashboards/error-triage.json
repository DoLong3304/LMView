        {
          "expr": "sum(rate(api_requests_total{status=~\"3..\"}[5m]))",
          "legendFormat": "3xx",
          "refId": "B"
        },
        {
          "expr": "sum(rate(api_requests_total{status=~\"4..\"}[5m]))",
          "legendFormat": "4xx",
          "refId": "C"
        },
        {
          "expr": "sum(rate(api_requests_total{status=~\"5..\"}[5m]))",
          "legendFormat": "5xx",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Error Ratio Over Time (1h / 6h / 24h)",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(rate(api_requests_total{status=~\"5..\"}[1h])) / sum(rate(api_requests_total[1h]))",
          "legendFormat": "5xx 1h",
          "refId": "A"
        },
        {
          "expr": "sum(rate(api_requests_total{status=~\"5..\"}[6h])) / sum(rate(api_requests_total[6h]))",
          "legendFormat": "5xx 6h",
          "refId": "B"
        },
        {
          "expr": "sum(rate(api_requests_total{status=~\"5..\"}[24h])) / sum(rate(api_requests_total[24h]))",
          "legendFormat": "5xx 24h",
          "refId": "C"

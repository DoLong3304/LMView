{
  "annotations": {"list": []},
  "description": "Executive overview: top-level SLIs, error budget status, top alerts firing, and platform health summary. Designed for on-call engineers and stakeholders.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {"title": "Data Flow Pipeline", "url": "/d/phase5-data-flow", "type": "link", "asDropdown": false, "includeVars": false, "keepTime": true, "tags": ["phase5"], "targetBlank": false},
    {"title": "WebSocket Serving", "url": "/d/phase5-websocket-serving", "type": "link", "asDropdown": false, "includeVars": false, "keepTime": true, "tags": ["phase5"], "targetBlank": false},
    {"title": "AI Ask Mode", "url": "/d/phase5-ai-ask-mode", "type": "link", "asDropdown": false, "includeVars": false, "keepTime": true, "tags": ["phase5"], "targetBlank": false},
    {"title": "SLO Burn Rate", "url": "/d/phase5-slo-burn-rate", "type": "link", "asDropdown": false, "includeVars": false, "keepTime": true, "tags": ["phase5"], "targetBlank": false}
  ],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Service Health Summary",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Exchanges Online",
      "gridPos": {"h": 4, "w": 3, "x": 0, "y": 1},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "count(producer_exchange_ws_connected == 1) or vector(0)", "legendFormat": "online", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 1}, {"color": "green", "value": 2}]}}},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Kafka Brokers",
      "gridPos": {"h": 4, "w": 3, "x": 3, "y": 1},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "count(kafka_server_broker_state == 1) or vector(0)", "legendFormat": "brokers", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short"}},
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Flink Job Up",
      "gridPos": {"h": 4, "w": 3, "x": 6, "y": 1},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "count(flink_jobmanager_job_uptime > 0) or vector(0)", "legendFormat": "jobs", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Redis Master Up",
      "gridPos": {"h": 4, "w": 3, "x": 9, "y": 1},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "redis_up or 0", "legendFormat": "up", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 6,
      "type": "stat",
      "title": "InfluxDB Up",
      "gridPos": {"h": 4, "w": 3, "x": 12, "y": 1},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "influxdb_up or 0", "legendFormat": "up", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 7,
      "type": "stat",
      "title": "FastAPI 5xx/s",
      "gridPos": {"h": 4, "w": 3, "x": 15, "y": 1},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "sum(rate(api_requests_total{status=~\"5..\"}[5m]))", "legendFormat": "5xx", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "ops"}},
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 8,
      "type": "stat",
      "title": "WS Connections",
      "gridPos": {"h": 4, "w": 3, "x": 18, "y": 1},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "sum(websocket_connections_active)", "legendFormat": "ws", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short"}},
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 9,
      "type": "stat",
      "title": "AI Sessions Active",
      "gridPos": {"h": 4, "w": 3, "x": 21, "y": 1},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "ai_active_sessions", "legendFormat": "ai", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "id": 10,
      "type": "row",
      "title": "SLO Status (1h window)",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5},
      "collapsed": false,
      "panels": []
    },
    {
      "id": 11,
      "type": "gauge",
      "title": "API Availability (target 99.9%)",
      "gridPos": {"h": 6, "w": 5, "x": 0, "y": 6},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "1 - (sum(rate(api_requests_total{status=~\"5..\"}[1h])) / sum(rate(api_requests_total[1h])))", "legendFormat": "sli", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0.99, "max": 1, "decimals": 4, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 0.999}, {"color": "green", "value": 0.9995}]}}}
    },
    {
      "id": 12,
      "type": "gauge",
      "title": "API p99 Latency (target < 500ms)",
      "gridPos": {"h": 6, "w": 5, "x": 5, "y": 6},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "histogram_quantile(0.99, sum by (le) (rate(api_request_duration_seconds_bucket[1h])))", "legendFormat": "p99", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.5}, {"color": "red", "value": 1}]}}}
    },
    {
      "id": 13,
      "type": "gauge",
      "title": "Data Freshness (target > 99% in 5s)",
      "gridPos": {"h": 6, "w": 5, "x": 10, "y": 6},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "(count(multi_source_last_update_timestamp > (time() - 5)) / count(multi_source_last_update_timestamp > 0))", "legendFormat": "fresh", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0.9, "max": 1, "decimals": 4, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 0.99}, {"color": "green", "value": 0.995}]}}}
    },
    {
      "id": 14,
      "type": "gauge",
      "title": "WS Delivery (target 99.5%)",
      "gridPos": {"h": 6, "w": 4, "x": 15, "y": 6},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "1 - (sum(rate(websocket_messages_dropped_total[1h])) / sum(rate(websocket_messages_pushed_total[1h]) + rate(websocket_messages_dropped_total[1h])))", "legendFormat": "sli", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0.99, "max": 1, "decimals": 4, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 0.995}, {"color": "green", "value": 0.999}]}}}
    },
    {
      "id": 15,
      "type": "gauge",
      "title": "AI Success Rate (target 95%)",
      "gridPos": {"h": 6, "w": 5, "x": 19, "y": 6},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "1 - (sum(rate(ai_requests_total{status=~\"provider_error|timeout\"}[1h])) / sum(rate(ai_requests_total[1h])))", "legendFormat": "sli", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0.9, "max": 1, "decimals": 4, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 0.95}, {"color": "green", "value": 0.98}]}}}
    },
    {
      "id": 20,
      "type": "row",
      "title": "Burn Rate (Google SRE Workbook - 1h fast window)",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 12},
      "collapsed": false,
      "panels": []
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "All SLOs Burn Rate (1h / 6h / 24h)",
      "gridPos": {"h": 7, "w": 24, "x": 0, "y": 13},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "(1 - (sum(rate(api_requests_total{status=~\"5..\"}[1h])) / sum(rate(api_requests_total[1h])))) / 0.001", "legendFormat": "API 1h", "refId": "A"},
        {"expr": "(1 - (sum(rate(api_requests_total{status=~\"5..\"}[6h])) / sum(rate(api_requests_total[6h])))) / 0.001", "legendFormat": "API 6h", "refId": "B"},
        {"expr": "(1 - (sum(rate(api_requests_total{status=~\"5..\"}[24h])) / sum(rate(api_requests_total[24h])))) / 0.001", "legendFormat": "API 24h", "refId": "C"},
        {"expr": "(1 - (sum(rate(websocket_messages_dropped_total[1h])) / sum(rate(websocket_messages_pushed_total[1h]) + rate(websocket_messages_dropped_total[1h])))) / 0.005", "legendFormat": "WS 1h", "refId": "D"},
        {"expr": "(1 - (1 - (count(multi_source_last_update_timestamp > (time() - 5)) / count(multi_source_last_update_timestamp > 0)))) / 0.01", "legendFormat": "Freshness 1h", "refId": "E"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 2}, {"color": "red", "value": 14.4}]}}},
      "options": {"legend": {"displayMode": "table", "placement": "right"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 30,
      "type": "row",
      "title": "Live Data Flow",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 20},
      "collapsed": false,
      "panels": []
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "End-to-End Throughput (records/s)",
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 21},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "sum(rate(producer_exchange_messages_received_total[5m]))", "legendFormat": "exchange → producer", "refId": "A"},
        {"expr": "sum(rate(flink_kafka_source_records_in_total[5m]))", "legendFormat": "Kafka → Flink", "refId": "B"},
        {"expr": "sum(rate(flink_writer_records_emitted_total[5m]))", "legendFormat": "Flink → Redis/Influx", "refId": "C"},
        {"expr": "sum(rate(websocket_messages_pushed_total[5m]))", "legendFormat": "Redis → WS", "refId": "D"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "End-to-End Latency (p99)",
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 21},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(api_request_duration_seconds_bucket[5m])))", "legendFormat": "API p99", "refId": "A"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(websocket_message_push_duration_seconds_bucket[5m])))", "legendFormat": "WS push p99", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le, source) (rate(multi_source_lookup_duration_seconds_bucket[5m])))", "legendFormat": "{{source}} lookup p99", "refId": "C"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(flink_writer_flush_duration_seconds_bucket[5m])))", "legendFormat": "Flink flush p99", "refId": "D"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    }
  ],
  "refresh": "15s",
  "schemaVersion": 38,
  "tags": ["phase5", "dataflow", "executive", "overview", "homepage"],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "timezone": "",
  "title": "Phase 5: Executive Overview",
  "uid": "phase5-executive-overview",
  "version": 1,
  "weekStart": ""
}

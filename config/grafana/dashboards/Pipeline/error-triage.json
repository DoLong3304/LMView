{
  "annotations": {
    "list": []
  },
  "description": "Error triage dashboard: top error endpoints, error code distribution, error spikes, status by service. Use to triage production issues and identify top failing components.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [

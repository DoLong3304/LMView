      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "100 - ((1 - (1 - (sum(rate(api_requests_total{status=~\"5..\"}[30d])) / sum(rate(api_requests_total[30d])))) / 0.001) * 100)",
          "legendFormat": "budget",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {

    {
      "id": 5,
      "title": "Scope Gate Decisions",
      "description": "Decisions made by the deterministic pre-LLM scope gate (in_scope / out_of_scope / injection)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "stacking": {
              "mode": "normal"
            }
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(ai_scope_gate_decisions_total[1m])) by (decision)",
          "legendFormat": "{{decision}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Scope Gate Refusal Rate",
      "description": "Ratio of out-of-scope / injection decisions to all scope gate decisions (5m avg)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.3
              },
              {
                "color": "red",
                "value": 0.6
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "sum(rate(ai_scope_gate_decisions_total{decision=~\"out_of_scope|injection\"}[5m])) / clamp_min(sum(rate(ai_scope_gate_decisions_total[5m])), 0.001)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Scope Gate Latency p95",
      "description": "95th percentile scope gate evaluation latency (target: < 1ms)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.005
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(ai_scope_gate_latency_seconds_bucket[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Provider Latency p50 / p95 / p99",
      "description": "Per-provider latency percentiles (each provider in its own row)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "last",
            "max"
          ]
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(ai_provider_latency_seconds_bucket{provider=~\"$provider\"}[5m])) by (le, provider))",
          "legendFormat": "p50 {{provider}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(ai_provider_latency_seconds_bucket{provider=~\"$provider\"}[5m])) by (le, provider))",
          "legendFormat": "p95 {{provider}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(ai_provider_latency_seconds_bucket{provider=~\"$provider\"}[5m])) by (le, provider))",
          "legendFormat": "p99 {{provider}}",
          "refId": "C"
        }
      ]
    },
    {
      "id": 9,
      "title": "Provider Request Outcomes",

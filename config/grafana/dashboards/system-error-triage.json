{
  "title": "System Error Triage",
  "tags": [
    "system",
    "logs",
    "errors",
    "observability"
  ],
  "description": "Single pane for ERROR-level logs across all services",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "title": "Error Rate by Service (5m)",
      "type": "barchart",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "targets": [
        {
          "expr": "sum by (service) (rate({log_level=\"ERROR\"} [5m]))",
          "legendFormat": "{{service}}",
          "queryType": "range"
        }
      ]
    },
    {
      "title": "All ERROR Logs (Last 30m)",
      "type": "logs",
      "gridPos": {
        "h": 20,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "targets": [
        {
          "expr": "{log_level=\"ERROR\"} | json",
          "legendFormat": "",
          "queryType": "range"
        }
      ],
      "options": {
        "showLabels": true,
        "showTime": true,
        "wrapLogMessage": true
      }
    }
  ]
}
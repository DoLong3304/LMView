    {
      "id": 31,
      "type": "timeseries",
      "title": "Indicator State Keys (B7: estimated loss on restart)",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 36
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (state_type) (flink_indicator_state_keys)",

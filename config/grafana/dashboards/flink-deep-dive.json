        "y": 36
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, state_type) (rate(flink_indicator_state_warmup_duration_seconds_bucket[30m])))",
          "legendFormat": "p50 {{state_type}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, state_type) (rate(flink_indicator_state_warmup_duration_seconds_bucket[30m])))",
          "legendFormat": "p95 {{state_type}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },

{
  "annotations": {
    "list": []
  },
  "description": "Flink job deep-dive: job uptime, checkpoint stats, backpressure, watermark lag, state size, source records, writer flush. Use to debug Flink pipeline health and 120s checkpoint (B6) and 500ms flush (B5) bottlenecks.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "Phase 5: Executive Overview",

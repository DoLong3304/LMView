    {
      "id": 33,
      "type": "timeseries",
      "title": "Kline Gap Fills per Minute (data quality)",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 43
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (exchange) (rate(flink_kline_gap_fills_total[5m]))",
          "legendFormat": "{{exchange}}",
          "refId": "A"
        },
        {
          "expr": "sum by (exchange) (rate(flink_indicator_recomputations_total[5m]))",
          "legendFormat": "recomp {{exchange}}",

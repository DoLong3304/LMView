        "x": 12,
        "y": 43
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, exchange) (rate(flink_kline_window_fill_ratio_bucket[10m])))",
          "legendFormat": "p50 {{exchange}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.05, sum by (le, exchange) (rate(flink_kline_window_fill_ratio_bucket[10m])))",
          "legendFormat": "p05 {{exchange}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
